# ===== 复制为 .env 后按需修改，供 docker compose 使用 =====

# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=agenthub
MYSQL_PASSWORD=agenthub123

# PostgreSQL + PGVector
PG_HOST=pgvector
PG_PORT=5432
PG_USER=agenthub
PG_PASSWORD=agenthub123
PG_DB=agenthub_vector

# MinIO
MINIO_HOST=minio
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# RocketMQ
ROCKETMQ_NAMESRV=rmqnamesrv:9876

# LLM（二选一：Ollama 本地模型 或 OpenAI 兼容接口）
LLM_DEFAULT_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://host.docker.internal:11434
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=

# Embedding（embedding 模型维度需与 agenthub.vector.dimension 一致）
EMBEDDING_MODEL=ollama-embed

# 任务队列：rocketmq | local
MQ_TYPE=rocketmq

# 文件存储：minio | local
STORAGE_TYPE=minio

# 文档解析：tika | mineru
PARSER_PROVIDER=tika
MINERU_HOST=mineru

# Agent 引擎：builtin | agentscope
AGENT_ENGINE=builtin

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
